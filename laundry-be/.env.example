APP_NAME=Laundry Multi-Platform
APP_ENV=development
APP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Rate limiting — batas default request/menit per-IP (global).
# Endpoint auth (login/register/otp) diperketat tersendiri di controller.
THROTTLE_LIMIT=300

# Payment gateway — secret untuk verifikasi webhook callback.
# Kosong di dev (verifikasi dilewati). WAJIB di-set di produksi.
PAYMENT_WEBHOOK_SECRET=

# CORS — pisahkan beberapa origin dengan koma
# Development: http://localhost:3001
# Production: https://admin.dicuciin.com
# Bisa pakai wildcard: https://*.dicuciin.com
# Hindari trailing slash agar konsisten (https://admin.dicuciin.com, bukan ...com/)
ALLOWED_ORIGINS=http://localhost:3001

# Margin laba bersih dalam persen (default 80 = 80%)
# Digunakan untuk kalkulasi estimasi profit di laporan keuangan
PROFIT_MARGIN_PERCENT=80

# Database
DATABASE_URL=postgresql://laundry:laundry_password@localhost:5432/laundry_db?schema=public
# Kredensial container Postgres (docker-compose). Di PRODUKSI, ganti password ini
# (jangan pakai default) dan selaraskan dengan DATABASE_URL di atas.
POSTGRES_USER=laundry
POSTGRES_PASSWORD=laundry_password
POSTGRES_DB=laundry_db

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Secret khusus verification token OTP (opsional; default = JWT_ACCESS_SECRET + "_otp")
JWT_OTP_SECRET=your-super-secret-otp-key-change-this-in-production

# WhatsApp OTP — provider pengirim OTP
# WA_PROVIDER: fonnte (default)
# WA_API_KEY: token dari provider. Bila kosong, OTP hanya di-log ke console (dev).
WA_PROVIDER=fonnte
WA_API_KEY=
WA_SENDER=

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT
MQTT_URL=mqtt://localhost:1883

# Promo & Loyalty (lihat docs/promo-loyalty-config.md)
# Rupiah per 1 poin saat earn (default 1000)
LOYALTY_POINT_RATE=1000
# Masa berlaku poin dalam hari (default 365; belum diterapkan ke earn — untuk job point-expiry)
LOYALTY_POINT_EXPIRY_DAYS=365
# Saat refund, debit balik cashback bonus tier (default false = perilaku lama)
LOYALTY_REVERSE_TIER_CASHBACK_ON_REFUND=false

# Scheduler (BullMQ + Redis) — lihat docs/promo-loyalty-scheduler.md
# Cron kampanye harian (default 01:00)
CAMPAIGN_CRON=0 1 * * *
# Cron kedaluwarsa poin harian (default 01:30)
LOYALTY_EXPIRY_CRON=30 1 * * *
